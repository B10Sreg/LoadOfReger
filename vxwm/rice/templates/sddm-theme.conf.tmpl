# Тема экрана входа. Собрана из палитры {{NAME}} генератором apply.py --
# правки затрутся, менять надо vxwm/rice/templates/sddm-theme.conf.tmpl.
#
# Файл читает греетер под root из /usr/share/sddm/themes/graphite/theme.conf,
# поэтому сюда он попадает через sddm/install.sh (там же и обои темы).
[General]
background=background.png

# Фон и плашки -- те же роли, что у окон: фон обычного окна и фон активного.
bgBase={{NORM_BG}}
bgAlt={{SEL_BG}}

# Текст: приглушённый для подписей, яркий для ввода, акцент для того, на что
# смотрят -- часы, фокус, кнопка входа.
fgBase={{NORM_FG}}
fgBright={{SEL_FG}}
fgAccent={{SEL_BORDER}}
borderColor={{SEL_BORDER}}
placeholderColor={{MUTED}}

# Успех и отказ берём из палитры терминала: зелёный и красный там уже
# подобраны под остальные цвета, а не взяты из ниоткуда.
successColor={{COLOR2}}
failureColor={{COLOR1}}

fontFamily=JetBrainsMono Nerd Font

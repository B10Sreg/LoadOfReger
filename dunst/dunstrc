[global]
    monitor = 0
    follow = mouse

    width = 320
    height = 120
    origin = top-right
    offset = 12x12
    scale = 0

    notification_limit = 5
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 280

    indicate_hidden = yes
    transparency = 8
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 2
    frame_color = "#c0c0c0"
    separator_color = frame
    sort = yes
    idle_threshold = 120

    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    corner_radius = 8
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e20"
    foreground = "#8a8a8e"
    frame_color = "#2a2a2d"
    timeout = 4

[urgency_normal]
    background = "#1e1e20"
    foreground = "#c0c0c0"
    frame_color = "#c0c0c0"
    timeout = 6

[urgency_critical]
    background = "#1e1e20"
    foreground = "#ffffff"
    frame_color = "#b06a6a"
    timeout = 0

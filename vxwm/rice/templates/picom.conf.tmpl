# Собран из rice.toml генератором apply.py. Правки затрутся.
# Backend & Rendering
backend = "{{BACKEND}}";
glx-no-stencil = true;
glx-copy-from-front = false;
# Перерисовываем только изменившееся. Проверено записью экрана: на плавность
# переезда окон при смене тега не влияет никак -- с false и с true кадры
# совпадают до пикселя. По умолчанию true: false заставляет GPU перерисовывать
# весь экран каждый кадр.
#
# Исключение -- проприетарный драйвер nvidia: там частичная перерисовка даёт
# мерцание и застрявшие куски окон. Выключается в rice.toml (use_damage = false),
# см. docs/nvidia.md.
use-damage = {{USE_DAMAGE}};

vsync = {{VSYNC}};

# --- Анимации ---
# Пружина, по которой picom догоняет новое положение и размер окна. Она же
# задаёт длительность анимаций появления и исчезновения: отдельных регуляторов
# у этой сборки нет.
#
# Главное здесь -- затухание НИЖЕ критического (крит. = 2*sqrt(k*m) = 19).
# Пружина с запасом по затуханию подходит к цели асимптотически и последние
# полсотни пикселей ползёт по 2 на кадр; клампинг обрезает перелёт, поэтому
# недодемпфированная приходит на место быстро и без качания. Замер записью
# экрана, шаг окна в пикселях по кадрам при переезде между тегами:
#
#   затухание 26 (выше крит.) : 164 98 176 104 134 48 86 18 52 4 32 0 22 0 14 0 10
#   затухание 16 (ниже крит.) : 254 194 158 110 70 48 32 20 16 10 6 4 2 2 2
#
# В первом случае 650 мс, скорость скачет туда-обратно и есть кадры, в которые
# окно не двигается вовсе -- это и есть "всё дёргается". Во втором 250 мс,
# ровное торможение, ни одного пропущенного кадра.
#
# Ключи -- имена этой сборки (FT-Labs, vgit-df4c6). Ни animation-stiffness, ни
# animation-mass, ни animation-for-workspace-switch-* в ней нет, хотя раньше
# стояли именно они: picom их молча игнорировал и крутил анимации на своих
# значениях по умолчанию, поэтому настройка тут ни на что не влияла.
animations = {{ANIMATIONS}};
animation-stiffness-in-tag = 300.0;
animation-stiffness-tag-change = 300.0;
animation-window-mass = 0.3;
animation-dampening = 16.0;
# Обязателен при затухании ниже критического: без него окно проезжает мимо
# места и возвращается.
animation-clamping = true;

# --- Смена тега ---
# Листание рисует эта же пружина на ветке ANIM_IN_TAG (win.c:721): у
# замапленного окна сменились координаты -- picom догоняет их. vxwm на смене
# тега ставит окна за край и обратно и не размапливает уезжающие, пока анимация
# не отыграет: modules/tagslide/tagslide.c, TAG_SLIDE_MS в modules.h. Значит
# скорость листания -- это animation-stiffness-in-tag выше.
#
# Ключей animation-for-*-tag тут нет, и вот почему. В сборке они есть, но
# включаются эвристикой по геометрии (win.c:699), рассчитанной на ванильный
# dwm, который прячет окна за верхний край экрана:
#
#   pending_g.y < 0 && g.y > 0 && |Δy| >= height  ->  ANIM_PREV_TAG
#   pending_g.y > 0 && g.y < 0 && |Δy| >= height  ->  ANIM_NEXT_TAG
#
# То есть любое перемещение окна через y = 0 длиннее его высоты уходило в эти
# ветки, а их дефолт -- OPEN_WINDOW_ANIMATION_NONE (src/config.c): телепорт. При
# вертикальном баре tagslide возит окна по Y, и одна из двух сторон листания
# всегда пересекала y = 0 -- вверх приезжающие окна возникали на месте, вниз
# мгновенно исчезали уезжающие.
#
# Поэтому picom собирается с патчем picom/patches/no-dwm-tag-heuristic.patch
# (picom/build-patched.sh, бинарь в ~/.local/bin): эвристика снята, и всякий
# переезд идёт по ANIM_IN_TAG. Теперь листание по вертикали едет пружиной в обе
# стороны, как и по горизонтали. Ставить animation-for-prev-tag/next-tag смысла
# нет -- с патчем эти ветки недостижимы.
#
# animation-stiffness-tag-change работает в паре с ними же, к проезду на
# ANIM_IN_TAG отношения не имеет.

# Появление и исчезновение окна. К листанию отношения почти не имеют -- с одной
# оговоркой: окна нового тега мапятся заново, поэтому open-анимация играет и на
# них, за кадром, пока окно ещё за краем экрана. При "zoom" окно въезжает,
# доразворачиваясь на ходу; если хочется чистого листания без этого -- поставь
# в rice.toml open_animation = "slide-in" (у picom это появление без анимации).
#
# Имена: zoom, slide-up, slide-down, slide-left, slide-right, slide-in,
# slide-out, slide-in-center, slide-out-center, squeeze, squeeze-bottom,
# minimize, fly-in, none. Все slide-* -- не переезд через экран, а разворот от
# одного из краёв самого окна.
animation-for-open-window = "{{OPEN_ANIMATION}}";
animation-for-unmap-window = "{{CLOSE_ANIMATION}}";
animation-for-transient-window = "{{OPEN_ANIMATION}}";

# Shadows & Blur
shadow = {{SHADOW}};
shadow-radius = {{SHADOW_RADIUS}};
shadow-opacity = {{SHADOW_OPACITY}};
shadow-offset-x = -{{SHADOW_RADIUS}};
shadow-offset-y = -{{SHADOW_RADIUS}};
shadow-exclude = [ "name = 'Notification'", "class_g = 'Rofi'" ];

blur-method = "dual_kawase";
blur-strength = {{BLUR_STRENGTH}};
blur-background = {{BLUR}};
# Бар (dock) теперь тоже размывается — раньше был в исключениях и оставался
# полностью читаемым, но плоским; со стеклянным фоном смотрится живее.
blur-background-exclude = [ "window_type = 'desktop'" ];

# Fading & Opacity
fading = {{FADING}};
# 0.12, а не 0.045: при смене тега vxwm прячет окна старого тега и
# показывает окна нового, picom видит это как закрытие и открытие и
# запускает fade. Долгий fade растягивал стык перехода -- замер: 83 мс
# пустого экрана при 0.045 против 66 мс при 0.12 (50 мс -- это уже сам
# vxwm, ниже не опустить). При этом появление окна остаётся плавным.
fade-in-step = 0.12;
fade-out-step = 0.12;
fade-delta = 6;
corner-radius = {{CORNER_RADIUS}};
rounded-corners-exclude = [ "window_type = 'dock'" ];

wintypes:
{
  # Прозрачный + размытый бар вместо сплошной плашки
  dock = { shadow = false; clip-shadow-above = true; opacity = {{BAR_OPACITY}}; blur-background = true; fade = true; }
  dnd = { shadow = false; }
  popup_menu = { opacity = {{MENU_OPACITY}}; shadow = false; fade = true; }
  dropdown_menu = { opacity = {{MENU_OPACITY}}; shadow = false; fade = true; }
};
# Неактивные окна приглушаются целиком: фокус видно, даже когда рамка ушла
# под край экрана. Исключения ниже перекрывают это значение.
inactive-opacity = {{INACTIVE_OPACITY}};
inactive-opacity-override = false;
focus-exclude = [ "window_type = 'dock'", "class_g = 'Rofi'" ];

# --- Правила прозрачности для конкретных приложений ---
# Проценты, а не доли: такой формат у picom. Считает их apply.py из
# [compositor] в rice.toml -- руками здесь править нечего.
# kitty и rofi в списке нет намеренно: у них своя прозрачность (у kitty --
# background_opacity, у rofi -- rgba() в теме), и вторая поверх неё дала бы
# блёклый текст.
opacity-rule = [
  "{{WINDOW_OPACITY_PCT}}:class_g = 'Thunar'",
  "{{WINDOW_OPACITY_PCT}}:class_g = 'Dolphin'",
  "{{WINDOW_OPACITY_PCT}}:class_g = 'firefox'",
  "{{BAR_OPACITY_PCT}}:class_g = 'vxwm'",   /* Сам бар: у него нет _NET_WM_WINDOW_TYPE=dock, поэтому таргетим по классу */
  "{{MENU_OPACITY_PCT}}:class_g = 'Dunst'"
];

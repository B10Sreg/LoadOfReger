#!/usr/bin/env bash
# =============================================================================
# vxwm-launcher: TUI Application Launcher Popup for vxwm
# =============================================================================

# Toggle: если лаунчер уже открыт, повторное нажатие хоткея закрывает его
if pgrep -f "vxwm/launcher.py" >/dev/null 2>&1; then
    pkill -f "vxwm/launcher.py"
    exit 0
fi

LAUNCHER_PY="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/launcher.py"

exec kitty \
    --class vxwm-launcher \
    --title "Application Launcher" \
    -o remember_window_size=no \
    -o initial_window_width=860 \
    -o initial_window_height=520 \
    -o confirm_os_window_close=0 \
    -o window_padding_width=8 \
    -o hide_window_decorations=yes \
    -e python3 "$LAUNCHER_PY" "$@"

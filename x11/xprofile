# Переменные окружения X-сессии. Читается двумя путями: менеджер входа
# (SDDM) подхватывает ~/.xprofile сам, а startx -- нет, поэтому session.sh
# берёт этот файл явно. Один файл на оба пути, чтобы сессия из меню входа и
# сессия из tty вели себя одинаково.

# Оптимизации драйверов для плавной анимации и устранения фризов
if [ -d /proc/driver/nvidia ] || lsmod 2>/dev/null | grep -q '^nvidia'; then
    # NVIDIA: отключаем буферизацию кадров в драйвере -- отклик анимаций мгновенный, без желе
    export __GL_MaxFramesAllowed=1
    # Ожидание vsync через usleep вместо busy-wait (устраняет просадки и нагрев)
    export __GL_YIELD=USLEEP
elif lsmod 2>/dev/null | grep -q '^amdgpu'; then
    # AMD: многопоточный диспетчер Mesa OpenGL для максимальной плавности
    export mesa_glthread=true
fi

# Qt: платформенную тему держит qt6ct, туда же apply.py кладёт палитру риса.
# Без этой переменной Qt-программы (qBittorrent, VLC) останутся серо-синими,
# сколько ни меняй тему.
export QT_QPA_PLATFORMTHEME=qt6ct
# Стиль -- отдельно от цветов: qt6ct красит, Breeze даёт форму виджетов.
export QT_STYLE_OVERRIDE=Breeze

# GTK-тему рис не навязывает: цвета он и так кладёт поверх, блоком в
# gtk.css (apply.py). Раскомментируй, если поставил Arc и хочешь его формы:
# export GTK_THEME=Arc-Dark

# Курсор и масштаб -- то, что чаще всего правят под свой монитор.
